{
    "ci": {
        "collect": {
            "url": [
                "http://localhost:3000",
                "http://localhost:3000/login",
                "http://localhost:3000/register",
                "http://localhost:3000/dashboard"
            ],
            "numberOfRuns": 1,
            "settings": {
                "preset": "desktop"
            }
        },
        "asset": {
            "assertions": {
                "categories:performance": [
                    "off"
                ],
                "categories:accessibility": [
                    "off"
                ],
                "categories:best-practices": [
                    "off"
                ],
                "categories:seo": [
                    "off"
                ]
            }
        },
        "upload": {
            "target": "filesystem",
            "outputDir": "./lhci-reports"
        }
    }
}