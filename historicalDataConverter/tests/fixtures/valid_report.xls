                <!-- Pendo Initialization -->
                
                <script type="text/javascript">
                (function() {
                    'use strict';
                    
                    // Debug: Log session info (non-PII)
                    console.log('%c[Pendo Integration ASPX] Script loaded, waiting for Pendo agent...', 'color: purple; font-weight: bold;');
                    
                    // Note: Email and full_name are intentionally omitted from Pendo to protect PII
                    // These values remain available in Session variables for dashboard use
                    var pendoConfig = {
                        visitor: {
                            id: 'ip_154.59.124.54',
                            role: 'ip_user',
                            user_type: 'IP',
                            is_admin: false,
                            client_id: '567',
                            client_name: 'Unknown Client'
                        },
                        account: {
                            id: '567',
                            name: 'Unknown Client'
                        }
                    };
                    
                    
                    var pendoLoginEvent = null;
                    
                    
                    var maxAttempts = 50;
                    var attempts = 0;
                    
                    function initPendo() {
                        attempts++;
                        
                        if (typeof window.pendo !== 'undefined' && 
                            window.pendo !== null && 
                            typeof window.pendo.initialize === 'function') {
                            
                            try {
                                window.pendo.initialize(pendoConfig);
                                
                                if (pendoLoginEvent !== null && typeof window.pendo.track === 'function') {
                                    window.pendo.track('UserLoggedIn', pendoLoginEvent);
                                }
                                
                                console.log('%câœ“ PENDO INITIALIZED SUCCESSFULLY', 'color: green; font-weight: bold; font-size: 14px;');
                                
                            } catch (err) {
                                console.error('%câœ— PENDO INITIALIZATION FAILED', 'color: red; font-weight: bold;', err);
                            }
                        } else if (attempts < maxAttempts) {
                            if (attempts % 5 === 0) {
                                console.log('[Pendo Init] Still waiting... (' + attempts + '/' + maxAttempts + ' attempts)');
                            }
                            setTimeout(initPendo, 200);
                        } else {
                            console.error('%câœ— PENDO AGENT FAILED TO LOAD after ' + (maxAttempts * 200 / 1000) + ' seconds', 'color: red; font-weight: bold;');
                            console.log('[Pendo Error] Check if pendo-unminified.js is loading correctly in Network tab');
                        }
                    }
                    
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', function() {
                            initPendo();
                        });
                    } else {
                        initPendo();
                    }
                })();
                </script>
                
				        
