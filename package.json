{
  "name": "autoflow-trade-simulator",
  "private": true,
  "scripts": {
    "db:start": "docker compose up -d db redis",
    "db:stop": "docker compose down",
    "db:seed": "node scripts/db-seed.js",
    "db:reset": "node scripts/db-reset.js",
    "migrate": "node scripts/migrate.js",
    "migrate:dev": "node scripts/migrate-dev.js",
    "setup": "node scripts/setup.js",
    "backend": "npm --prefix backend run dev",
    "backend:start": "docker compose up -d --build backend",
    "frontend": "npm run dev --prefix frontend",
    "poller:start": "docker compose up -d --build data-harvester",
    "poller:stop": "docker compose stop data-harvester",
    "poller:logs": "docker compose logs -f data-harvester",
    "lint:backend": "python -m ruff check backend/app backend/tests",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "test:backend": "cd backend && python -m pytest",
    "test:stock-poller": "pip install -r stock-poller/requirements-test.txt && pytest stock-poller/tests -v",
    "test:frontend": "npm --prefix frontend run test",
    "test": "npm run test:backend; npm run test:stock-poller; npm run test:frontend; npm run test:playwright",
    "dev": "npm run backend & npm run frontend",
    "start": "npm run start --prefix backend & npm run start --prefix frontend",
    "test:lhci": "lhci autorun",
    "test:k6": "docker run --rm --network=host --env-file .env -v \"$PWD/backend/tests/performance:/tests\" grafana/k6 run /tests/performance-baseline.js",
    "test:perf": "npm run test:lhci && npm run test:k6",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "fuse.js": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.5.0",
    "dotenv-cli": "^11.0.0",
    "pg": "^8.23.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0"
  }
}
