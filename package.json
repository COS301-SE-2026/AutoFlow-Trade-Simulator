{
  "name": "autoflow-trade-simulator",
  "private": true,
  "scripts": {
    "db:start": "docker compose up -d db redis",
    "db:stop": "docker compose down",
    "db:seed": "node scripts/db-seed.js",
    "db:reset": "node scripts/db-reset.js",
    "migrate": "node scripts/migrate.js",
    "migrate:dev": "node scripts/migrate-dev.js",
    "setup": "node scripts/setup.js",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm run dev --prefix frontend",
    "lint:backend": "python -m ruff check backend/app backend/tests",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "test:backend": "cd backend && python -m pytest",
    "test": "npm run test:backend",
    "dev": "npm run backend & npm run frontend",
    "start": "npm run start --prefix backend & npm run start --prefix frontend",
    "lhci": "lhci autorun",
    "k6": "k6 run backend/tests/performance/performance-baseline.js",
    "perf": "npm run lhci && npm run k6"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0"
  }
}